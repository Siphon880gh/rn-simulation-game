    "product_focus": "Clinical Training",
    "product_focus_text": "This RN simulator drops players into a compressed 12-hour nursing shift filled with real-world events, diverse patients, and escalating case studies. Success means triaging tasks, acing clinical mini-games, and staying on schedule; failure means clocking overtime—or worse, missing the critical moment that leads to patient injury.",
    "markdown_renderer_rationale": "Default for Help/learning MD: plugin surface for wiki links, Mermaid fences, and KaTeX math; matches locked vanilla CDN shell. marked kept only as rejected thin fallback.",
    "ui_motion": "css_first",
    "ui_motion_rationale": "E7.M1: CSS panel-swap + status pulse; no GSAP until CSS ceiling proven.",
    "skipped_doc": "SKIPPED_MILESTONES.md",
    "admission_census_mode": "hold_last_pack_patient",
    "admission_census_mode_rationale": "E9: census=minus1|openAdmit holds last pack patients[] id off boot census; openAdmit spawns that patient mid-shift with admission checklist. Reuse bed-prep + critical-lab Dr callback/recall.",
    "right_rail": "orders_tools_declarative",
    "right_rail_rationale": "E10: always-visible Orders (doctor-orders-check + injected) + Tools (awaiting MD, IV, admit) via right-menu.js subscribe; Global stays detail; no DOM scrape.",
    "orders_carryover_procedures": "carryover_both_plus_max_one_procedure",
    "orders_carryover_procedures_rationale": "E11: carry undelivered pack injections + overdue injected orders; engine injects ≤1 diagnosis-matched sudden procedure with consent; sameDay ≥2h or tomorrow NPO until midnight.",
    "care_schedules": "turn_q2h_opt_in",
    "care_schedules_rationale": "E12: Q2H turn/reposition via GameConfig.careSchedules + patient opt-in (config and/or data-care-schedule); assessment Perform/slot; for obesity, bedbound, stroke/weakness risk.",
    "delegation_assist": "cct_half_hour_cna_staggered_thirds_team_solo",
    "delegation_assist_rationale": "E13: Delegate rail. ICU CCT half-hour windows; floor ≤2 CNAs on distinct non-overlapping shift thirds; select aide highlights tasks. team=turns ½ time; solo=instant (data-delegate-mode=solo)."
